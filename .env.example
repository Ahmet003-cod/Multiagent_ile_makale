# ==============================================================================
# MULTI-AGENT WORKFLOW - ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# Bu dosyayı '.env' olarak kopyalayın ve kendi API anahtarlarınızı girin.
# ==============================================================================

# LLM Sağlayıcı Tercihi: 'gemini', 'groq' veya 'openai' (Boş bırakılırsa anahtarı bulunan otomatik seçilir)
LLM_PROVIDER=gemini

# 1. GOOGLE GEMINI (Önerilen - Ücretsiz API: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. GROQ CLOUD (Ultra Hızlı - Ücretsiz API: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OPENAI (GPT-4o / GPT-4o-mini: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 4. ARAMA MOTORLARI
# Tavily Search API (İsteğe bağlı - https://tavily.com - Yoksa DuckDuckGo ve arXiv otomatik kullanılır)
TAVILY_API_KEY=your_tavily_api_key_here

# 5. SUNUCU AYARLARI
HOST=127.0.0.1
PORT=8000
